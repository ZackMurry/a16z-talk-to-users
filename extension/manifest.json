{
  "manifest_version": 3,
  "name": "Bring Your Own Agent to Sheets",
  "short_name": "BYOA Sheets",
  "version": "0.1.0",
  "description": "Expose the open Google Sheet to your own AI agent over WebMCP \u2014 previews, approvals, audit and context sync. Works through the page; no API keys.",
  "key": "",
  "minimum_chrome_version": "146",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://docs.google.com/spreadsheets/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "action": {
    "default_title": "Open BYOA Sheets panel",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/spreadsheets/d/*"
      ],
      "js": [
        "src/bridge.js",
        "src/driver.js",
        "src/preview.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://docs.google.com/spreadsheets/d/*"
      ],
      "js": [
        "src/webmcp.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}